{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "dataset_version",
    "records"
  ],
  "properties": {
    "dataset_version": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "signal_class",
          "phrase",
          "hypotheses_en",
          "observable_context_en",
          "next_action_en",
          "publication_status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "signal_class": {
            "enum": [
              "positive",
              "ambiguous",
              "soft-no",
              "hard-no"
            ]
          },
          "phrase": {
            "type": "object",
            "required": [
              "en",
              "sk",
              "cs",
              "de",
              "pl"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "hypotheses_en": {
            "type": "string"
          },
          "observable_context_en": {
            "type": "string"
          },
          "next_action_en": {
            "type": "string"
          },
          "publication_status": {
            "type": "string"
          }
        }
      }
    }
  }
}
